# App reads DATABASE_URL, or falls back to Vercel Postgres vars
# (POSTGRES_PRISMA_URL / POSTGRES_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Used to sign admin/creator login cookies. Not required to create a cookbook,
# but set a long random value in production.
JWT_SECRET="change-me-to-a-long-random-secret"
