# Local development uses SQLite (file DB). Production on Vercel uses Postgres.
# npm run dev prepares a SQLite schema automatically.
DATABASE_URL="file:./dev.db"

# Used to sign user session cookies.
JWT_SECRET="change-me-to-a-long-random-secret"

# Vercel Blob — required for cook result photo uploads (local + production).
# Create a Blob store on your Vercel project (private is fine), then paste the
# read/write token here and in the Vercel project Environment Variables.
# The app stores photos privately and serves them through /api/cook-photos/...
BLOB_READ_WRITE_TOKEN=""

# Production (Vercel) should set DATABASE_URL to your Postgres connection string
# (or POSTGRES_PRISMA_URL / POSTGRES_URL from Vercel Storage).
