{
  "name": "cookbook-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-sqlite-schema.cjs && prisma generate --schema=prisma/schema.sqlite.prisma && prisma db push --schema=prisma/schema.sqlite.prisma && next dev",
    "build": "node scripts/ensure-database-url.cjs && prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "node scripts/prepare-sqlite-schema.cjs && prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:push": "node scripts/prepare-sqlite-schema.cjs && prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:studio": "node scripts/prepare-sqlite-schema.cjs && prisma studio --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "next": "14.2.18",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "postcss": "^8",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
